# No credentials are required for read-only NVD and CISA connectors.
NANOU_DATA_DIR=~/.local/share/nanou-cyber-defense-ai
NANOU_HTTP_TIMEOUT_SECONDS=15
# Required to enable local malware metadata read/write API endpoints.
# Generate locally; never commit the actual value.
NANOU_METADATA_API_TOKEN=
# Optional NVD API key. Store locally or in a secret manager only.
# NVD_API_KEY=
