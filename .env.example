# No credentials are required for read-only NVD and CISA connectors.
NANOU_DATA_DIR=~/.local/share/nanou-cyber-defense-ai
NANOU_HTTP_TIMEOUT_SECONDS=15
# Required to enable local malware metadata read/write API endpoints.
# Generate locally; never commit the actual value.
NANOU_METADATA_API_TOKEN=
# Optional NVD API key. Store locally or in a secret manager only.
# NVD_API_KEY=

# Optional operator-configured static-feature model artifact.
# Only use an artifact produced by the controlled benchmark workflow.
# Never upload model files through the web UI.
# NANOU_MALWARE_MODEL_PATH=/absolute/path/to/static-malware-detector-v1.joblib
# NANOU_MALWARE_MODEL_SHA256=trusted-64-character-sha256
# NANOU_MALWARE_MODEL_DATASET_ID=ember2024-apk
# Experimental default only; select operational thresholds using a separate validation set.
NANOU_MALWARE_MODEL_THRESHOLD=0.5
