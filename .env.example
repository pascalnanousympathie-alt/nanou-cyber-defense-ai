# Local development defaults to SQLite in NANOU_DATA_DIR.
# Hosted/serverless deployments MUST set the least-privilege runtime role URL.
# Keep real values only in the hosting provider's encrypted secret store.
NANOU_RUNTIME_DATABASE_URL=
# Legacy URL is for local development compatibility only; never use it on Vercel.
NANOU_DATABASE_URL=
NANOU_BOOTSTRAP_TOKEN=
NANOU_DATA_DIR=~/.local/share/nanou-cyber-defense-ai
NANOU_HTTP_TIMEOUT_SECONDS=15

# Authentication/session controls.
NANOU_SESSION_COOKIE_NAME=nanou_session
NANOU_SESSION_TTL_HOURS=12
NANOU_AUTH_ATTEMPTS_PER_WINDOW=10
NANOU_AUTH_RATE_WINDOW_SECONDS=900

# Optional operator-configured static-feature model artifact.
# Only use an artifact produced by the controlled benchmark workflow.
# Never upload model files through the web UI.
# NANOU_MALWARE_MODEL_PATH=/absolute/path/to/static-malware-detector-v1.joblib
# NANOU_MALWARE_MODEL_SHA256=trusted-64-character-sha256
# NANOU_MALWARE_MODEL_DATASET_ID=ember2024-apk
NANOU_MALWARE_MODEL_THRESHOLD=0.5
